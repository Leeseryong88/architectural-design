# =============================================================================
# 면적노트 (Myeonjeok Note) 환경변수 설정 예시
# =============================================================================
# 1. 실행 모드 선택 ("demo" 또는 "live")
# - demo: Firebase·Gemini 설정 없이 즉시 실행 (브라우저 IndexedDB 저장 + 가상 도면 고정 fixture 사용)
# - live: Firebase Authentication·Firestore·Storage 및 서버 전용 Gemini API 사용
#   (주의: live 모드에서 아래 설정값이 비어 있으면 데모 모드로 자동 전환하지 않고 설정 오류를 안내합니다.)
NEXT_PUBLIC_APP_MODE=demo

# =============================================================================
# 2. Firebase 웹 클라이언트 설정 (NEXT_PUBLIC_APP_MODE=live 시 필수)
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹)에서 복사하여 입력합니다.
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# 3. Firebase Admin SDK 서버 전용 설정 (NEXT_PUBLIC_ 접두사 절대 금지)
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성(JSON)에서 확인합니다.
# - FIREBASE_PRIVATE_KEY 입력 방법:
#   * 로컬 .env.local 에서는 큰따옴표로 감싸고 줄바꿈을 \n 으로 유지하세요.
#     예: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
#   * Vercel 대시보드(Environment Variables)에 입력할 때는 큰따옴표 없이 원본 줄바꿈 그대로 붙여넣거나
#     \n 이 포함된 문자열을 붙여넣어도 서버(src/lib/config/server-env.ts)에서 자동으로 파싱합니다.
# =============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =============================================================================
# 4. Gemini API 서버 전용 설정 (NEXT_PUBLIC_ 접두사 절대 금지)
# Google AI Studio (https://aistudio.google.com/) 에서 발급받은 API 키와
# 이미지 입력 및 구조화 JSON 출력(responseMimeType: "application/json")을 지원하는 공식 모델 ID를 입력합니다.
# 예: GEMINI_MODEL_ID=gemini-2.5-flash 또는 gemini-2.5-pro
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL_ID=
