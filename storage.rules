rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // 1. 원본 PDF 도면 업로드 경로:
    // users/{ownerId}/projects/{projectId}/documents/{documentId}/{fileName}
    match /users/{ownerId}/projects/{projectId}/documents/{documentId}/{fileName} {
      allow read: if isOwner(ownerId);

      allow create, update: if isOwner(ownerId)
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && fileName.matches('.*\\.[pP][dD][fF]$');

      allow delete: if isOwner(ownerId);
    }

    // 2. 확정본 및 검토용 스냅샷 출력 파일(엑셀·PDF) 경로:
    // users/{ownerId}/projects/{projectId}/snapshots/{snapshotId}/{fileName}
    match /users/{ownerId}/projects/{projectId}/snapshots/{snapshotId}/{fileName} {
      allow read: if isOwner(ownerId);

      allow create, update: if isOwner(ownerId)
        && request.resource.size <= 30 * 1024 * 1024;

      allow delete: if isOwner(ownerId);
    }

    match /users/{ownerId}/projects/{projectId}/exports/{snapshotId}/{fileName} {
      allow read: if isOwner(ownerId);

      allow create, update: if isOwner(ownerId)
        && request.resource.size <= 30 * 1024 * 1024;

      allow delete: if isOwner(ownerId);
    }

    // 그 외 모든 경로 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
